# ==============================================================================
# BIẾN MÔI TRƯỜNG DỰ ÁN CMS LIÊN TỈNH (DÙNG CHO DOCKER COMPOSE TRÊN VPS)
# Copy file này thành .env trên VPS: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE POSTGRESQL
# ------------------------------------------------------------------------------
POSTGRES_USER=cms
POSTGRES_PASSWORD=your_strong_postgres_password_here
POSTGRES_DB=cms
DB_PORT=5432

# ------------------------------------------------------------------------------
# 2. CỔNG MAPPING TRÊN VPS (Host Port : Container Port)
# ------------------------------------------------------------------------------
WEBSITE_PORT=3000
ADMIN_PORT=5173
BACKEND_PORT=3001

# ------------------------------------------------------------------------------
# 3. BACKEND CMS & PAYLOAD CONFIG
# ------------------------------------------------------------------------------
# Chuỗi bí mật Payload CMS (ít nhất 32 ký tự ngẫu nhiên)
PAYLOAD_SECRET=your_super_secret_payload_key_minimum_32_characters_long

# URL công khai của Backend API (dùng domain của bạn hoặc IP VPS)
# Ví dụ: https://api.xegheplientinh.vn hoặc http://103.xxx.xxx.xxx:3001
PAYLOAD_PUBLIC_SERVER_URL=https://api.xegheplientinh.vn

# URL công khai của Website (Next.js)
FRONTEND_URL=https://xegheplientinh.vn

# Khóa bí mật cho cơ chế On-Demand Revalidation và tra cứu ID
REVALIDATE_SECRET=your_random_secret_revalidate_token_here
LOOKUP_SECRET=your_random_secret_lookup_token_here
IP_SALT=your_random_secret_ip_salt_hash_here

# Tự động đẩy DB Schema lúc khởi động container (đặt true ở lần chạy đầu nếu cần)
PAYLOAD_DB_PUSH=false

# ------------------------------------------------------------------------------
# 4. TÀI KHOẢN ADMIN BAN ĐẦU (SEED ADMIN)
# ------------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@xegheplientinh.vn
SEED_ADMIN_PASSWORD=YourStrongAdminPassword123!

# ------------------------------------------------------------------------------
# 5. THÔNG BÁO TELEGRAM (BOT GỬI ĐƠN ĐẶT XE)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_FALLBACK_EMAIL=ops@xegheplientinh.vn

# ------------------------------------------------------------------------------
# 6. ADMIN SPA & WEBSITE CLIENT CONFIG
# ------------------------------------------------------------------------------
# Để mặc định /api nếu dùng Nginx reverse-proxy trong cùng domain/port
# Hoặc điền URL backend: https://api.xegheplientinh.vn/api
ADMIN_VITE_API_URL=/api

# Client-side API URL cho website Next.js
NEXT_PUBLIC_CMS_URL=https://api.xegheplientinh.vn
