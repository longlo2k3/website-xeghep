# ==============================================================================
# CẤU HÌNH NGINX REVERSE PROXY & SSL (LET'S ENCRYPT) TRÊN VPS
# File mẫu đặt tại /etc/nginx/sites-available/cms.conf trên máy chủ VPS
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. WEBSITE KHÁCH HÀNG (VD: xegheplientinh.vn & www.xegheplientinh.vn)
# ------------------------------------------------------------------------------
server {
    listen 80;
    server_name xegheplientinh.vn www.xegheplientinh.vn;

    # Tự động chuyển hướng sang HTTPS khi cài xong SSL Certbot
    # return 301 https://$host$request_uri;

    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# ------------------------------------------------------------------------------
# 2. GIAO DIỆN QUẢN TRỊ ADMIN SPA (VD: admin.xegheplientinh.vn)
# ------------------------------------------------------------------------------
server {
    listen 80;
    server_name admin.xegheplientinh.vn;

    # return 301 https://$host$request_uri;

    location / {
        proxy_pass http://127.0.0.1:4002;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# ------------------------------------------------------------------------------
# 3. BACKEND API & PAYLOAD CMS (VD: api.xegheplientinh.vn)
# ------------------------------------------------------------------------------
server {
    listen 80;
    server_name api.xegheplientinh.vn;

    # return 301 https://$host$request_uri;

    # Cho phép upload ảnh dung lượng lớn lên CMS (mặc định nginx là 1MB)
    client_max_body_size 50M;

    location / {
        proxy_pass http://127.0.0.1:4001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 60s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }
}
